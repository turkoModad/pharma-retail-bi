# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copiar como .env y reemplazar todos los placeholders por valores reales:
#   cp .env.example .env
# ==============================================================================

ENVIRONMENT=production
APP_HOST=127.0.0.1
APP_PORT=8480
DATABASE_URL=sqlite+aiosqlite:///./data/authsec.db
APP_BASE_URL=https://tu-dominio.com
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
CORS_ORIGINS=["https://tu-dominio.com"]
ALLOWED_HOSTS=["tu-dominio.com","localhost","127.0.0.1"]
TRUSTED_PROXIES=["127.0.0.1","::1"]

# Claves criptográficas (mínimo 32 caracteres en modo producción)
# Generar SECRET_KEY / HMAC_SECRET / CSRF_SECRET con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Generar FERNET_KEY con:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CAMBIAR_POR_CLAVE_SEGURA_64_CHARS
FERNET_KEY=CAMBIAR_POR_CLAVE_FERNET_BASE64_44_CHARS
HMAC_SECRET=CAMBIAR_POR_CLAVE_HMAC_SEGURA_64_CHARS
CSRF_SECRET=CAMBIAR_POR_CLAVE_CSRF_SEGURA_64_CHARS

# SMTP
SMTP_HOST=smtp.proveedor-correo.com
SMTP_PORT=587
SMTP_USER=usuario_smtp@tu-dominio.com
SMTP_PASSWORD=CAMBIAR_POR_CLAVE_SMTP_SEGURA
SMTP_FROM_EMAIL=noreply@tu-dominio.com
SMTP_FROM_NAME="Seguridad AuthSec"
SMTP_TLS=true

# ------------------------------------------------------------------------------
