# Puerto de depuración remota de Google Chrome
CHROME_DEBUG_PORT=9222

# Configuración del portal proveedor (completar en .env antes de ejecutar el scraper)
TARGET_DOMAIN=proveedor-ejemplo.com
ORIGIN_URL=https://proveedor-ejemplo.com
REFERER_URL=https://proveedor-ejemplo.com/
API_URL=https://api.proveedor-ejemplo.com/product/search/name
